<UserControl x:Class="SparkingUnverum.UI.CategoriesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:l="clr-namespace:SparkingUnverum"
             xmlns:ui="clr-namespace:SparkingUnverum.UI"
             Background="#202020" PreviewKeyDown="Panel_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- A mod: picture, name and the folders it is in -->
        <DataTemplate x:Key="CardTemplate" DataType="{x:Type ui:ModCard}">
            <Border Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" CornerRadius="4" Background="#2a2a2a" ToolTip="{Binding Name}">
                <StackPanel>
                    <Grid Height="{Binding CardImageHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" ClipToBounds="True">
                        <Border Background="#333333" CornerRadius="4,4,0,0">
                            <TextBlock Text="{Binding Initials}" FontSize="30" FontWeight="Bold" Foreground="#5f5f5f" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Image Source="{Binding Image}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                            <Setter Property="Opacity" Value="0.55"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <Border Margin="5" Padding="3,2" CornerRadius="3" Background="#CC181818" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" ToolTip="{l:Tr Categories.EnabledTooltip}" dd:DragDrop.DragSourceIgnore="True"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Name}" Margin="6,4,6,0" Foreground="#f2f2f2" FontWeight="SemiBold" FontSize="13"
                               TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding CategoriesText}" Margin="6,2,6,6" FontSize="11" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCategory}" Value="False">
                                        <Setter Property="Foreground" Value="#808080"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="CardContainer" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame" Margin="3" Padding="1" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#5a5a5a"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Frame" Property="Background" Value="#3a2a1a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A folder: picture or initials of the character, symbol of a general folder -->
        <DataTemplate DataType="{x:Type l:ModCategory}">
            <Border x:Name="Tile" Width="134" Height="140" Margin="4" CornerRadius="6" Background="#2a2a2a" BorderThickness="2" BorderBrush="Transparent"
                    Cursor="Hand" ToolTip="{Binding Name}" MouseLeftButtonUp="Folder_Click" ContextMenuOpening="Folder_ContextMenuOpening">
                <Border.ContextMenu>
                    <ContextMenu/>
                </Border.ContextMenu>
                <StackPanel VerticalAlignment="Center">
                    <Grid Width="66" Height="66" HorizontalAlignment="Center">
                        <Ellipse Fill="#3a3a3a"/>
                        <TextBlock Text="{Binding Initials}" FontSize="22" FontWeight="Bold" Foreground="#c2c2c2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Character}" Value="True"/>
                                                <Condition Binding="{Binding HasImage}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <fa5:ImageAwesome Icon="{Binding SymbolIcon}" Height="30" Foreground="#c2c2c2">
                            <fa5:ImageAwesome.Style>
                                <Style TargetType="fa5:ImageAwesome">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Character}" Value="False"/>
                                                <Condition Binding="{Binding HasImage}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </fa5:ImageAwesome.Style>
                        </fa5:ImageAwesome>
                        <Ellipse Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding IconImage}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="{Binding Name}" Margin="6,6,6,0" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"
                               FontWeight="SemiBold" Foreground="#f2f2f2" FontSize="13"/>
                    <TextBlock Text="{Binding Summary}" TextAlignment="Center" Foreground="#a2a2a2" FontSize="11" Margin="4,1,4,0"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="#5a5a5a"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="Tile" Property="Background" Value="#3a2a1a"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:NewFolderTile}">
            <Grid Width="134" Height="140" Margin="4" Background="Transparent" Cursor="Hand" ToolTip="{l:Tr Categories.NewTooltip}" MouseLeftButtonUp="NewFolder_Click">
                <Rectangle x:Name="Dash" RadiusX="6" RadiusY="6" Stroke="#555555" StrokeThickness="2" StrokeDashArray="4 3"/>
                <StackPanel VerticalAlignment="Center">
                    <fa5:ImageAwesome Icon="Solid_Plus" Height="22" Foreground="#a2a2a2"/>
                    <TextBlock Text="{Binding Label}" Margin="6,8,6,0" TextAlignment="Center" TextWrapping="Wrap" Foreground="#c2c2c2" FontSize="13"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Dash" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapItems">
            <WrapPanel/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.7*" MinWidth="380"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- Live filter and options -->
        <Grid Grid.ColumnSpan="3" Margin="0,5,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Height="35">
                <TextBox x:Name="SearchBox" Background="#353535" Foreground="#f2f2f2" BorderBrush="#353535" Padding="5,0,30,0" FontSize="15"
                         VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                <TextBlock Padding="8,0,5,0" Foreground="#909090" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="14" Text="{l:Tr Categories.SearchHint}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=SearchBox, Path=Text.IsEmpty}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <fa5:ImageAwesome Icon="Solid_Times" Foreground="#f2f2f2" HorizontalAlignment="Right" Margin="0,0,10,0" Height="14" Cursor="Hand"
                                  PreviewMouseLeftButtonDown="ClearSearch_Click">
                    <fa5:ImageAwesome.Style>
                        <Style TargetType="fa5:ImageAwesome">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=SearchBox, Path=Text.IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </fa5:ImageAwesome.Style>
                </fa5:ImageAwesome>
            </Grid>
            <ComboBox x:Name="ShowBox" Grid.Column="1" Width="200" Height="35" Margin="8,0,0,0" FontSize="14" SelectionChanged="ShowBox_SelectionChanged">
                <ComboBoxItem IsSelected="True" Content="{l:Tr Categories.ShowAll}"/>
                <ComboBoxItem x:Name="UncategorizedItem"/>
                <ComboBoxItem Content="{l:Tr Categories.ShowCategorized}"/>
                <ComboBoxItem Content="{l:Tr Categories.ShowEnabled}"/>
                <ComboBoxItem Content="{l:Tr Categories.ShowDisabled}"/>
            </ComboBox>
            <CheckBox x:Name="DescriptionCheck" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#f2f2f2" FontSize="13"
                      Content="{l:Tr Categories.SearchDescription}" ToolTip="{l:Tr Categories.SearchDescriptionTooltip}"
                      Checked="DescriptionCheck_Changed" Unchecked="DescriptionCheck_Changed"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" ToolTip="{l:Tr Categories.CardSizeTooltip}">
                <fa5:ImageAwesome Icon="Regular_Image" Height="13" Foreground="#a2a2a2" Margin="0,0,6,0"/>
                <Slider x:Name="SizeSlider" Width="110" Minimum="140" Maximum="340" SmallChange="10" LargeChange="40" VerticalAlignment="Center" ValueChanged="SizeSlider_ValueChanged"/>
                <fa5:ImageAwesome Icon="Regular_Image" Height="19" Foreground="#a2a2a2" Margin="6,0,0,0"/>
            </StackPanel>
            <Border Grid.Column="4" Margin="14,0,0,0" Height="35" CornerRadius="3" Background="{StaticResource AccentBrush}">
                <Button Margin="2" Padding="14,0" FontSize="15" FontWeight="SemiBold" Foreground="#f2f2f2" Content="{l:Tr Categories.Close}" Click="Close_Click"/>
            </Border>
        </Grid>

        <!-- What is being shown -->
        <DockPanel Grid.Row="1" Margin="2,0,0,4">
            <Border x:Name="FolderChip" DockPanel.Dock="Left" Visibility="Collapsed" CornerRadius="3" Background="#3a2a1a" BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1" Padding="8,3" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="FolderChipText" Foreground="#f2f2f2" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center" Cursor="Hand" Foreground="{StaticResource AccentBrush}"
                               Text="{l:Tr Categories.ShowEverything}" MouseLeftButtonUp="ClearFolder_Click" TextDecorations="Underline"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="ResultText" Foreground="#c2c2c2" FontSize="13" VerticalAlignment="Center"/>
            <TextBlock Margin="12,0,0,0" FontSize="13" VerticalAlignment="Center" Cursor="Hand" Foreground="{StaticResource AccentBrush}"
                       Text="{l:Tr Categories.SelectAll}" MouseLeftButtonUp="SelectAll_Click" TextDecorations="Underline"/>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource AccentBrush}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- Every mod as a picture -->
        <Border Grid.Row="2" Background="#1a1a1a" BorderBrush="#424242" BorderThickness="1">
            <Grid>
                <ListBox x:Name="CardList" ItemTemplate="{StaticResource CardTemplate}" ItemContainerStyle="{StaticResource CardContainer}" ItemsPanel="{StaticResource WrapItems}"
                         SelectionMode="Extended" Background="Transparent" BorderThickness="0" Padding="2"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible"
                         dd:DragDrop.IsDragSource="True" dd:DragDrop.UseDefaultDragAdorner="True" dd:DragDrop.DefaultDragAdornerOpacity="0.75"
                         SelectionChanged="CardList_SelectionChanged" KeyDown="CardList_KeyDown" ContextMenuOpening="CardList_ContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu/>
                    </ListBox.ContextMenu>
                </ListBox>
                <TextBlock x:Name="EmptyText" Visibility="Collapsed" Foreground="#909090" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="{l:Tr Categories.NoMatch}" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- Folders -->
        <Border Grid.Row="2" Grid.Column="2" Background="#1a1a1a" BorderBrush="#424242" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Visible">
                <StackPanel Margin="6,4,6,10">
                    <StackPanel Orientation="Horizontal" Margin="4,4,4,4">
                        <TextBlock Text="{l:Tr Categories.Characters}" FontSize="18" FontWeight="Bold" Foreground="#f2f2f2"/>
                        <TextBlock x:Name="CharactersCount" Foreground="#a2a2a2" Margin="8,0,0,2" FontSize="13" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <ItemsControl x:Name="CharacterList" ItemsPanel="{StaticResource WrapItems}"
                                  dd:DragDrop.IsDropTarget="True"/>
                    <StackPanel Orientation="Horizontal" Margin="4,14,4,4">
                        <TextBlock Text="{l:Tr Categories.General}" FontSize="18" FontWeight="Bold" Foreground="#f2f2f2"/>
                        <TextBlock x:Name="GeneralCount" Foreground="#a2a2a2" Margin="8,0,0,2" FontSize="13" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <ItemsControl x:Name="GeneralList" ItemsPanel="{StaticResource WrapItems}"
                                  dd:DragDrop.IsDropTarget="True"/>
                    <TextBlock Margin="6,14,6,0" Foreground="#909090" FontSize="12" TextWrapping="Wrap" Text="{l:Tr Categories.Tip}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
