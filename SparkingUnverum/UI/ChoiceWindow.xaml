<Window x:Class="SparkingUnverum.UI.ChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SparkingUnverum"
        Title="Sparking Unverum" WindowStartupLocation="CenterOwner" Icon="../Assets/app.ico"
        ResizeMode="NoResize" Width="460"
        Background="#202020" ShowActivated="True" SizeToContent="Height">
    <Window.Resources>
        <DataTemplate x:Key="ChoiceTemplate">
            <Button Click="SelectButton_Click" Margin="5" HorizontalContentAlignment="Stretch" Background="#494949">
                <Grid VerticalAlignment="Center" Margin="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="18" FontWeight="Bold" Foreground="#f2f2f2" TextWrapping="Wrap" Text="{Binding Path=OptionText}"/>
                    <TextBlock Grid.Row="1" FontSize="13" TextWrapping="WrapWithOverflow" Foreground="#a2a2a2" Text="{Binding Path=OptionSubText}"/>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListView MaxHeight="500" Style="{StaticResource ListviewStyle}" Name="ChoiceList" Grid.Row="0" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource ChoiceTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListViewItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Focusable" Value="false"/>
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
        <Button Grid.Row="1" Margin="5" Name="CancelButton" Content="{l:Tr Common.Cancel}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Stretch" Height="40" Background="#494949" Foreground="#f2f2f2" Click="CancelButton_Click" IsCancel="True"/>
    </Grid>
</Window>
