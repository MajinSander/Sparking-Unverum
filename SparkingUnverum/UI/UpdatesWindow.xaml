<Window x:Class="SparkingUnverum.UI.UpdatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        xmlns:l="clr-namespace:SparkingUnverum"
        Title="{l:Tr Updates.Title}" WindowStartupLocation="CenterOwner" Icon="../Assets/app.ico"
        Width="760" Height="640" MinWidth="560" MinHeight="400" Background="#202020">
    <Window.Resources>
        <DataTemplate x:Key="UpdateTemplate">
            <Border Margin="5" CornerRadius="3" Background="#2c2c2c" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <CheckBox VerticalAlignment="Center" Margin="0,0,10,0" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                    <Image Grid.Column="1" Width="120" Height="68" Stretch="UniformToFill" Margin="0,0,10,0" VerticalAlignment="Top"
                           Source="{Binding Image, IsAsync=True}"/>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#f2f2f2" TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="13" Foreground="#F28C1E" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Title, Mode=OneWay}"/>
                            <Run Text=" • "/>
                            <Run Text="{Binding When, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="#c2c2c2" TextWrapping="Wrap" MaxHeight="70" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                                   Text="{Binding Changes}" ToolTip="{Binding Changes}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasChanges}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="#FFD000" Margin="0,4,0,0" Text="{l:Tr Updates.ManualOnly}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ManualOnly}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="5,0,5,6">
            <CheckBox DockPanel.Dock="Right" Name="AllCheckbox" IsChecked="True" VerticalAlignment="Center" Checked="All_Changed" Unchecked="All_Changed">
                <TextBlock Text="{l:Tr Updates.SelectAll}" Foreground="#f2f2f2" FontSize="14"/>
            </CheckBox>
            <TextBlock Name="Header" Foreground="#f2f2f2" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>
        <ListView Grid.Row="1" Name="UpdateList" Style="{StaticResource ListviewStyle}" Background="Transparent" BorderThickness="0"
                  ItemTemplate="{StaticResource UpdateTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListViewItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Focusable" Value="false"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Margin="5" Height="40" CornerRadius="2" Background="{StaticResource AccentBrush}">
                <Button Margin="2" Content="{l:Tr Updates.UpdateSelected}" FontSize="16" FontWeight="Bold" Foreground="#f2f2f2" Click="Update_Click" IsDefault="True"/>
            </Border>
            <Button Grid.Column="1" Margin="5" Height="40" Content="{l:Tr Updates.SkipSelected}" FontSize="16" FontWeight="Bold" Background="#494949" Foreground="#f2f2f2" Click="Skip_Click"
                    ToolTip="{l:Tr Updates.SkipTooltip}"/>
            <Button Grid.Column="2" Margin="5" Height="40" Content="{l:Tr Updates.Later}" FontSize="16" FontWeight="Bold" Background="#494949" Foreground="#f2f2f2" Click="Later_Click" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
