<Window x:Class="SparkingUnverum.UI.ShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        xmlns:l="clr-namespace:SparkingUnverum"
        Title="{l:Tr Share.Title}" Icon="../Assets/app.ico" Background="#202020" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" SizeToContent="Height" Width="640">
    <StackPanel Margin="20,16,20,18">
        <TextBlock Text="{l:Tr Share.What}" Foreground="#f2f2f2" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <RadioButton x:Name="EnabledRadio" GroupName="What" IsChecked="True" Foreground="#f2f2f2" FontSize="14" Margin="0,0,0,6" Checked="Option_Changed"/>
        <RadioButton x:Name="AllRadio" GroupName="What" Foreground="#f2f2f2" FontSize="14" Margin="0,0,0,10" Checked="Option_Changed"/>
        <CheckBox x:Name="FoldersCheck" Foreground="#f2f2f2" FontSize="14" Content="{l:Tr Share.WithFolders}" ToolTip="{l:Tr Share.WithFoldersTooltip}"
                  Margin="0,0,0,14" Checked="Option_Changed" Unchecked="Option_Changed"/>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="{l:Tr Share.ListTitle}" Foreground="#c2c2c2" VerticalAlignment="Center" Margin="0,0,10,6"/>
            <TextBox x:Name="TitleBox" Grid.Column="1" Height="28" Margin="0,0,0,6" Background="#303030" BorderBrush="#353535" Foreground="#f2f2f2" VerticalContentAlignment="Center"
                     TextChanged="Option_Changed"/>
            <TextBlock Grid.Row="1" Text="{l:Tr Share.Author}" Foreground="#c2c2c2" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="AuthorBox" Grid.Row="1" Grid.Column="1" Height="28" Background="#303030" BorderBrush="#353535" Foreground="#f2f2f2" VerticalContentAlignment="Center"
                     TextChanged="Option_Changed"/>
        </Grid>
        <StackPanel Orientation="Horizontal">
            <Border CornerRadius="3" Background="{StaticResource AccentBrush}">
                <Button x:Name="CreateButton" Margin="2" Padding="22,6" FontSize="15" FontWeight="SemiBold" Foreground="#f2f2f2" Content="{l:Tr Share.Create}" Click="Create_Click"/>
            </Border>
            <TextBlock x:Name="WorkingText" Foreground="#a2a2a2" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed" Text="{l:Tr Share.Working}"/>
        </StackPanel>

        <StackPanel x:Name="ResultPanel" Visibility="Collapsed" Margin="0,16,0,0">
            <TextBlock x:Name="SummaryText" Foreground="#f2f2f2" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBox x:Name="CodeBox" IsReadOnly="True" TextWrapping="Wrap" Height="96" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                     Background="#181818" BorderBrush="#353535" Foreground="#c2c2c2" Padding="4"/>
            <TextBlock x:Name="LengthText" Foreground="#a2a2a2" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button Padding="16,6" Margin="0,0,10,0" FontSize="14" Foreground="#f2f2f2" Click="Copy_Click" AutomationProperties.Name="{l:Tr Share.Copy}">
                    <StackPanel Orientation="Horizontal">
                        <fa5:ImageAwesome Icon="Regular_Copy" Height="13" Foreground="#f2f2f2" Margin="0,0,7,0"/>
                        <TextBlock Text="{l:Tr Share.Copy}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Padding="16,6" FontSize="14" Foreground="#f2f2f2" Click="Save_Click" AutomationProperties.Name="{l:Tr Share.Save}">
                    <StackPanel Orientation="Horizontal">
                        <fa5:ImageAwesome Icon="Regular_Save" Height="13" Foreground="#f2f2f2" Margin="0,0,7,0"/>
                        <TextBlock Text="{l:Tr Share.Save}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock x:Name="DoneText" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <!-- The mods that can't be downloaded, really, in a zip with the list -->
            <Border x:Name="PackPanel" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,10" CornerRadius="4" Background="#2a2433">
                <StackPanel>
                    <TextBlock x:Name="PackText" Foreground="#f2f2f2" FontSize="13" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="PackButton" Padding="16,6" FontSize="14" Foreground="#f2f2f2" Click="Pack_Click" AutomationProperties.Name="{l:Tr Share.PackButton}">
                            <StackPanel Orientation="Horizontal">
                                <fa5:ImageAwesome Icon="Solid_FileArchive" Height="13" Foreground="#C9A0FF" Margin="0,0,7,0"/>
                                <TextBlock Text="{l:Tr Share.PackButton}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PackCancelButton" Padding="16,6" Margin="10,0,0,0" FontSize="14" Foreground="#f2f2f2" Content="{l:Tr Common.Cancel}"
                                Visibility="Collapsed" Click="PackCancel_Click"/>
                    </StackPanel>
                    <ProgressBar x:Name="PackBar" Height="8" Margin="0,10,0,0" Foreground="#C9A0FF" Background="#303030" BorderThickness="0" Visibility="Collapsed"/>
                    <TextBlock x:Name="PackStatus" Foreground="#C9A0FF" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border BorderBrush="#353535" BorderThickness="0,1,0,0" Margin="0,18,0,12"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Padding="20,6" FontSize="14" Foreground="#f2f2f2" Content="{l:Tr Common.Close}" Click="Close_Click" IsCancel="True"/>
            <TextBlock VerticalAlignment="Center" FontSize="13" Cursor="Hand" Foreground="{StaticResource AccentBrush}" TextDecorations="Underline"
                       Text="{l:Tr Share.ImportLink}" MouseLeftButtonUp="Import_Click"/>
        </DockPanel>
    </StackPanel>
</Window>
