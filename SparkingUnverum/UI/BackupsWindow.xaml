<Window x:Class="SparkingUnverum.UI.BackupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SparkingUnverum"
        Title="{l:Tr Backups.Title}" WindowStartupLocation="CenterOwner" Icon="../Assets/app.ico"
        Width="760" Height="560" MinWidth="560" MinHeight="380" Background="#202020">
    <Window.Resources>
        <DataTemplate x:Key="BackupTemplate">
            <Border Margin="5" CornerRadius="3" Background="#2c2c2c" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#f2f2f2"/>
                        <TextBlock Text="{Binding Details}" Foreground="#c2c2c2"/>
                        <TextBlock Text="{Binding Status}" Foreground="#F28C1E" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Border CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,0,0,6">
                            <Button Margin="2" Height="30" Padding="12,0" FontWeight="Bold" Foreground="#f2f2f2" Content="{l:Tr Backups.Clean}"
                                    IsEnabled="{Binding CanClean}" Click="Clean_Click" ToolTip="{l:Tr Backups.CleanTooltip}"/>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Button Height="28" Padding="10,0" Margin="0,0,6,0" Background="#494949" Foreground="#f2f2f2" Content="{l:Tr Backups.Open}" Click="Open_Click"/>
                            <Button Height="28" Padding="10,0" Background="#494949" Foreground="#f2f2f2" Content="{l:Tr Backups.Recycle}" Click="Recycle_Click"
                                    ToolTip="{l:Tr Backups.RecycleTooltip}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Margin="5,0,5,8" Text="{l:Tr Backups.Explanation}" Foreground="#c2c2c2" FontSize="13" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Name="Message" Foreground="#f2f2f2" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="BackupList" ItemTemplate="{StaticResource BackupTemplate}"/>
        </ScrollViewer>
        <Button Grid.Row="2" Margin="5,8,5,0" Height="38" FontSize="16" FontWeight="Bold" Background="#494949" Foreground="#f2f2f2"
                Content="{l:Tr Common.Close}" Click="Close_Click" IsCancel="True"/>
    </Grid>
</Window>
