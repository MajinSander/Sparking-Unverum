<Window x:Class="SparkingUnverum.UI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        xmlns:l="clr-namespace:SparkingUnverum"
        xmlns:ui="clr-namespace:SparkingUnverum.UI"
        Title="{l:Tr History.Title}" WindowStartupLocation="CenterOwner" Icon="../Assets/app.ico"
        Width="860" Height="640" MinWidth="620" MinHeight="420" Background="#202020">
    <Window.Resources>
        <Style x:Key="HiddenWhenEmpty" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type ui:HistoryDay}">
            <TextBlock Text="{Binding Title}" Foreground="#f2f2f2" FontSize="16" FontWeight="Bold" Margin="6,12,6,4"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:HistoryRow}">
            <Border x:Name="Row" Margin="4,3" Padding="12,8" CornerRadius="4" Background="#2a2a2a" BorderThickness="2" BorderBrush="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Top" Margin="0,1,0,0">
                        <TextBlock Text="{Binding Time}" Foreground="#f2f2f2" FontSize="15" FontWeight="SemiBold"/>
                        <fa5:ImageAwesome Icon="{Binding Icon}" Height="13" Foreground="#909090" HorizontalAlignment="Left" Margin="1,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Title}" Foreground="#f2f2f2" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" Foreground="#a2a2a2" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" Style="{StaticResource HiddenWhenEmpty}"
                                   ToolTip="{Binding FullDetail}"/>
                        <TextBlock Text="{Binding Counts}" Foreground="#7a7a7a" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" x:Name="NowChip" CornerRadius="3" Background="#3a2a1a" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                            Padding="10,3" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="{l:Tr History.Now}" Foreground="#f2f2f2" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <Button Grid.Column="2" x:Name="Back" Height="30" Padding="12,0" VerticalAlignment="Center" Background="#494949" Foreground="#f2f2f2"
                            FontWeight="SemiBold" Content="{l:Tr History.GoBack}" ToolTip="{l:Tr History.GoBackTooltip}" Click="GoBack_Click"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="NowChip" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Back" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Explanation" Margin="5,0,5,10" Foreground="#c2c2c2" FontSize="13" TextWrapping="Wrap"/>
        <DockPanel Grid.Row="1" Margin="5,0,5,6">
            <Border CornerRadius="3" Background="{StaticResource AccentBrush}" DockPanel.Dock="Left">
                <!-- Nothing to undo: it looks off too -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled, ElementName=UndoButton}" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Button x:Name="UndoButton" Margin="2" Height="34" Padding="14,0" FontSize="14" FontWeight="Bold" Foreground="#f2f2f2" Click="Undo_Click"
                        ToolTip="{l:Tr History.UndoTooltip}" AutomationProperties.Name="{l:Tr History.Undo}">
                    <StackPanel Orientation="Horizontal">
                        <fa5:ImageAwesome Icon="Solid_Undo" Height="13" Foreground="#f2f2f2" Margin="0,0,8,0"/>
                        <TextBlock Text="{l:Tr History.Undo}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Border>
            <TextBlock x:Name="StatusText" Margin="14,0,0,0" Foreground="{StaticResource AccentBrush}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
        <TextBlock Grid.Row="2" x:Name="EmptyText" Text="{l:Tr History.Empty}" Foreground="#909090" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="30" Visibility="Collapsed"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="HistoryList"/>
        </ScrollViewer>
        <Button Grid.Row="3" Margin="5,8,5,0" Height="38" FontSize="16" FontWeight="Bold" Background="#494949" Foreground="#f2f2f2"
                Content="{l:Tr Common.Close}" Click="Close_Click" IsCancel="True"/>
    </Grid>
</Window>
