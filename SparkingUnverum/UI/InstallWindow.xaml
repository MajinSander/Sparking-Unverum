<Window x:Class="SparkingUnverum.UI.InstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SparkingUnverum"
        Title="{l:Tr Install.Title}" Icon="../Assets/app.ico" Background="#202020" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" SizeToContent="Height" Width="580">
    <StackPanel Margin="24,18,24,20">
        <Image Source="../Assets/preview.png" Height="150" Margin="0,0,0,6"/>
        <TextBlock Name="Heading" FontSize="22" FontWeight="Bold" Foreground="#f2f2f2" HorizontalAlignment="Center"/>
        <TextBlock Text="{l:Tr Install.Subtitle}" FontSize="14" Foreground="#a2a2a2" HorizontalAlignment="Center" Margin="0,2,0,18"/>

        <TextBlock Text="{l:Tr Install.Folder}" Foreground="#f2f2f2" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Name="FolderBox" Height="30" IsReadOnly="True" Background="#303030" BorderBrush="#353535" Foreground="#f2f2f2"
                     VerticalContentAlignment="Center" Padding="4,0"/>
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,0" Height="30" Foreground="#f2f2f2" Content="{l:Tr Install.Change}" Click="Change_Click"/>
        </Grid>
        <TextBlock Text="{l:Tr Install.FolderNote}" Foreground="#909090" FontSize="12" Margin="0,4,0,14" TextWrapping="Wrap"/>

        <CheckBox Name="DesktopCheck" IsChecked="True" Foreground="#f2f2f2" Content="{l:Tr Install.Desktop}" Margin="0,0,0,6"/>
        <CheckBox Name="StartMenuCheck" IsChecked="True" Foreground="#f2f2f2" Content="{l:Tr Install.StartMenu}"/>

        <TextBlock Name="ErrorText" Foreground="#FFB0B0" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Cursor="Hand" Foreground="#a2a2a2" FontSize="12" TextDecorations="Underline"
                       Text="{l:Tr Install.Portable}" ToolTip="{l:Tr Install.PortableTooltip}" MouseLeftButtonUp="Portable_Click"/>
            <Border Grid.Column="1" Height="38" CornerRadius="3" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                <Button Name="InstallButton" Margin="2" Padding="26,0" FontSize="16" FontWeight="SemiBold" Foreground="#f2f2f2"
                        Content="{l:Tr Install.Install}" Click="Install_Click" IsDefault="True"/>
            </Border>
            <Button Grid.Column="2" Height="38" Padding="18,0" FontSize="15" Foreground="#f2f2f2" Content="{l:Tr Common.Cancel}" Click="Cancel_Click" IsCancel="True"/>
        </Grid>
    </StackPanel>
</Window>
