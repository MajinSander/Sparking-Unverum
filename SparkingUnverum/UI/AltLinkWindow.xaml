<Window x:Class="SparkingUnverum.UI.AltLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SparkingUnverum"
        Title="Sparking Unverum" WindowStartupLocation="CenterOwner" Icon="../Assets/app.ico"
        ResizeMode="NoResize" Width="680"
        Background="#202020" ShowActivated="True" SizeToContent="Height">
    <Window.Resources>
        <DataTemplate x:Key="FileTemplate">
            <Button Click="SelectButton_Click" Margin="5" HorizontalContentAlignment="Stretch" Background="#494949">
                <Grid VerticalAlignment="Center" Margin="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="18" FontWeight="Bold" Foreground="#f2f2f2" Text="{Binding Path=Description}"/>
                    <TextBlock Grid.Row="1" FontSize="13" TextWrapping="WrapWithOverflow" Foreground="#a2a2a2" Text="{Binding Path=Url}"/>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Padding="10,2,10,2" Foreground="White" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" Name="TitleBox"/>
        <TextBlock Name="Description" Grid.Row="1" TextWrapping="Wrap" Margin="10,4,10,2" Foreground="White" FontSize="15"/>
        <TextBox BorderThickness="0" IsReadOnly="True" Name="PathText" Grid.Row="2" TextWrapping="WrapWithOverflow" FontWeight="Bold" Margin="8,0,8,0" Background="Transparent" Foreground="#F28C1E" FontSize="15"/>
        <TextBlock Name="FetchDescription" Grid.Row="3" TextWrapping="Wrap" Margin="10,8,10,2" Foreground="White" FontSize="15"/>
        <TextBox BorderThickness="0" IsReadOnly="True" Name="UrlText" Grid.Row="4" TextWrapping="WrapWithOverflow" FontWeight="Bold" Margin="8,0,8,0" Background="Transparent" Foreground="#F28C1E" FontSize="15"/>
        <ListView MaxHeight="500" Style="{StaticResource ListviewStyle}" Name="FileList" Grid.Row="5" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource FileTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListViewItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Focusable" Value="false"/>
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
        <Button Grid.Row="6" Margin="5" Name="CancelButton" Content="{l:Tr Common.Close}" FontSize="18" FontWeight="Bold" Height="40" Background="#494949" Foreground="#f2f2f2" Click="CancelButton_Click" IsCancel="True"/>
    </Grid>
</Window>
