<Window x:Class="SparkingUnverum.UI.ImportListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SparkingUnverum"
        xmlns:ui="clr-namespace:SparkingUnverum.UI"
        Title="{l:Tr Import.Title}" Icon="../Assets/app.ico" Background="#202020" WindowStartupLocation="CenterOwner"
        Width="740" Height="700" MinWidth="560" MinHeight="480" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <DataTemplate DataType="{x:Type ui:ImportRow}">
            <Grid Margin="2,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" Foreground="{Binding Color}" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#f2f2f2" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{Binding Color}" Margin="10,0,4,0" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{l:Tr Import.Instructions}" Foreground="#c2c2c2" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CodeInput" Height="58" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                         Background="#181818" BorderBrush="#353535" Foreground="#c2c2c2" Padding="4" TextChanged="CodeInput_TextChanged"/>
                <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,0" FontSize="13" Foreground="#f2f2f2" Content="{l:Tr Import.OpenFile}" Click="OpenFile_Click"/>
            </Grid>
            <TextBlock x:Name="ErrorText" Foreground="#FFB0B0" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel x:Name="PreviewHeader" Grid.Row="1" Margin="0,14,0,8" Visibility="Collapsed">
            <TextBlock x:Name="ListTitle" Foreground="#f2f2f2" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ListInfo" Foreground="#a2a2a2" FontSize="12" Margin="0,2,0,8"/>
            <TextBlock x:Name="InstalledText" Foreground="#8BC34A" FontSize="13"/>
            <TextBlock x:Name="DownloadText" Foreground="#7FC8FF" FontSize="13"/>
            <TextBlock x:Name="MissingText" Foreground="#FF8A65" FontSize="13" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#353535" BorderThickness="1" Background="#1a1a1a">
            <Grid>
                <ListBox x:Name="ItemsList" Background="Transparent" BorderThickness="0" Foreground="#f2f2f2" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                <TextBlock x:Name="WaitText" Foreground="#909090" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Text="{l:Tr Import.Waiting}" Margin="20"/>
            </Grid>
        </Border>

        <Grid x:Name="OptionsPanel" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="{l:Tr Import.ProfileName}" Foreground="#c2c2c2" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="ProfileBox" Grid.Column="1" Height="28" Background="#303030" BorderBrush="#353535" Foreground="#f2f2f2" VerticalContentAlignment="Center"/>
            <CheckBox x:Name="FoldersCheck" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Foreground="#f2f2f2" IsChecked="True"/>
        </Grid>

        <StackPanel x:Name="ProgressPanel" Grid.Row="4" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ProgressText" Foreground="#f2f2f2" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
            <ProgressBar x:Name="TotalBar" Height="8" Foreground="{StaticResource AccentBrush}" Background="#303030" BorderThickness="0" Margin="0,0,0,4"/>
            <ProgressBar x:Name="FileBar" Height="4" Foreground="#7FC8FF" Background="#303030" BorderThickness="0"/>
        </StackPanel>

        <TextBlock x:Name="DoneText" Grid.Row="4" Foreground="{StaticResource AccentBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Border x:Name="ImportBorder" CornerRadius="3" Background="{StaticResource AccentBrush}" Margin="0,0,10,0" IsEnabled="False">
                <Button x:Name="ImportButton" Margin="2" Padding="22,6" FontSize="15" FontWeight="SemiBold" Foreground="#f2f2f2" Content="{l:Tr Import.Import}" Click="Import_Click"/>
            </Border>
            <Button x:Name="CloseButton" Padding="20,6" FontSize="14" Foreground="#f2f2f2" Content="{l:Tr Common.Close}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
