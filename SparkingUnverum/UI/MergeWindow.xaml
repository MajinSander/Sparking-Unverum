<Window x:Class="SparkingUnverum.UI.MergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        xmlns:l="clr-namespace:SparkingUnverum"
        Title="{l:Tr Merge.Title}" WindowStartupLocation="CenterOwner" Icon="../Assets/app.ico"
        Width="820" Height="680" MinWidth="620" MinHeight="420" Background="#202020">
    <Window.Resources>
        <DataTemplate x:Key="FolderTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Foreground="#f2f2f2" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                    <TextBlock Text="{Binding Description}" Foreground="#a2a2a2" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="#c2c2c2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="2" Height="28" FontSize="13" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                          DisplayMemberPath="FileName" ToolTip="{l:Tr Merge.DownloadTooltip}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="GroupTemplate">
            <Border Margin="5" CornerRadius="3" Background="#2c2c2c" Padding="10">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Foreground="#F28C1E" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" Foreground="#f2f2f2" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <Grid Margin="0,6,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:Tr Merge.FolderHeader}" Foreground="#909090" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{l:Tr Merge.SizeHeader}" Foreground="#909090" FontSize="11" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="2" Text="{l:Tr Merge.DownloadHeader}" Foreground="#909090" FontSize="11"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Folders}" ItemTemplate="{StaticResource FolderTemplate}"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:Tr Merge.NameLabel}" Foreground="#f2f2f2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Height="26" Background="#303030" BorderBrush="#353535" Foreground="#f2f2f2" VerticalContentAlignment="Center"
                                 Text="{Binding MergedName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <TextBlock Text="{l:Tr Merge.KeptSeparateLabel}" Foreground="#909090" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding KeptSeparate}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="{l:Tr Merge.KeepSeparate}" Height="34" Padding="14,0" Margin="0,0,10,0" FontWeight="SemiBold" Background="#494949" Foreground="#f2f2f2"
                                Click="KeepSeparate_Click" ToolTip="{l:Tr Merge.KeepSeparateTooltip}"/>
                        <Border CornerRadius="2" Background="{StaticResource AccentBrush}">
                            <Button Margin="2" Content="{l:Tr Merge.Merge}" Height="30" Padding="14,0" FontWeight="Bold" Foreground="#f2f2f2"
                                    Click="Merge_Click" ToolTip="{l:Tr Merge.MergeTooltip}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="5,0,5,8">
            <TextBlock Text="{l:Tr Merge.Explanation}" Foreground="#c2c2c2" FontSize="13" TextWrapping="Wrap"/>
            <CheckBox Name="ShowKept" Margin="0,8,0,0" Checked="ShowKept_Changed" Unchecked="ShowKept_Changed">
                <TextBlock Text="{l:Tr Merge.ShowKept}" Foreground="#f2f2f2"/>
            </CheckBox>
        </StackPanel>
        <TextBlock Grid.Row="1" Name="Message" Foreground="#f2f2f2" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="GroupList" ItemTemplate="{StaticResource GroupTemplate}"/>
        </ScrollViewer>
        <Button Grid.Row="2" Margin="5,8,5,0" Height="38" FontSize="16" FontWeight="Bold" Background="#494949" Foreground="#f2f2f2"
                Content="{l:Tr Common.Close}" Click="Close_Click" IsCancel="True"/>
    </Grid>
</Window>
